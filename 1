#include <iostream>
using namespace std;

int main() {
    int num;
    cout << "Enter a number (maximum of 4 digits): ";
    cin >> num;

    if (num <= 0) {
        cout << "It is a non-positive number" << endl;
    }
    else if (num > 9999) {
        cout << "Invalid input. Only up to four digits are allowed." << endl;
    }
    else {
        cout << "It is a positive number." << endl;

        if (num < 10)
            cout << "The number has 1 digit." << endl;
        else if (num < 100)
            cout << "The number has 2 digits." << endl;
        else if (num < 1000)
            cout << "The number has 3 digits." << endl;
        else
            cout << "The number has 4 digits." << endl;
    }

    return 0;
}
